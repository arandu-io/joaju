{
    "options": {
        "failByDrop": false
    },
    "outdir": "/reports",
    "servers": [
        {
            "agent": "joaju/ws",
            "url": "ws://host.docker.internal:9001",
            "options": {
                "version": 18
            }
        }
    ],
    "cases": [
        "*"
    ],
    "exclude-cases": [
        "12.*",
        "13.*"
    ],
    "exclude-agent-cases": {}
}
